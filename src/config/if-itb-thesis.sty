% Ukuran kertas
\special{papersize=210mm,297mm}

% Setting margin
\usepackage[top=3cm,bottom=2.5cm,left=4cm,right=2.5cm]{geometry}

\usepackage{mathptmx}

% Judul bahasa Indonesia
\usepackage[bahasa]{babel}

% Format citation
\usepackage[backend=bibtex,style=authoryear,sorting=nyt,maxcitenames=2,maxbibnames=99,
  giveninits=true,uniquename=false,uniquelist=false,dashed=false,url=false,isbn=false]{biblatex}
\addbibresource{references.bib}
\let\parentcite\parencite

% biblatex tidak punya lbx Indonesia; petakan babel bahasa → english lbx
\DeclareLanguageMapping{bahasa}{english}
\DeclareLanguageMapping{indonesian}{english}
\newcommand{\IndoAndOthers}{dkk\adddot}
% String berlaku untuk bahasa aktif (bahasa) maupun lbx english yang dipetakan
\DefineBibliographyStrings{bahasa}{%
  and       = {dan},
  andothers = {dkk\adddot},
  andmore   = {dkk\adddot},
  in        = {Dalam},
  page      = {hlm\adddot},
  pages     = {hlm\adddot},
  edition   = {ed\adddot},
}
\DefineBibliographyStrings{english}{%
  and       = {dan},
  andothers = {dkk\adddot},
  andmore   = {dkk\adddot},
  in        = {Dalam},
  page      = {hlm\adddot},
  pages     = {hlm\adddot},
  edition   = {ed\adddot},
}
\renewbibmacro*{name:andothers}{%
  \ifboolexpr{%
    test {\ifnumequal{\value{listcount}}{\value{liststop}}}%
    and test \ifmorenames%
  }{%
    \ifnumgreater{\value{liststop}}{1}{\finalandcomma}{}%
    \printdelim{andothersdelim}\IndoAndOthers
  }{}%
}
\renewbibmacro*{list:andothers}{%
  \ifboolexpr{%
    test {\ifnumequal{\value{listcount}}{\value{liststop}}}%
    and test \ifmoreitems%
  }{%
    \ifnumgreater{\value{liststop}}{1}{\finalandcomma}{}%
    \printdelim{andmoredelim}\IndoAndOthers
  }{}%
}

